# Normaliza fim de linha: LF no repositorio, independente de quem commita.
# Sem isto o git avisa "LF will be replaced by CRLF" a cada `git add` no Windows
# e os scripts de build (que escrevem CRLF) sujam o diff sem mudar conteudo.
* text=auto eol=lf

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf

# Scripts .bat precisam de CRLF pra rodar direito no Windows
*.bat   text eol=crlf

# Binarios: nunca converter
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.ico   binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary

# Nao contar os HTML gerados como codigo escrito a mao nas estatisticas do GitHub
projeto-*.html linguist-generated=true
blog-*.html    linguist-generated=true
