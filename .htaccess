# Apache, so vale na Hostinger. O GitHub Pages ignora este arquivo.
#
# O repo inteiro foi clonado dentro do public_html, entao tools/, docs/,
# CLAUDE.md e README.md ficaram legiveis por qualquer um em slowexe.com.
# O docs/PENDENCIAS.md e documento interno. Isto fecha a porta.

# ---- arquivos que nao sao site ----
RedirectMatch 404 ^/(tools|docs)(/|$)
<FilesMatch "\.(md|py|bat|sh|yml|yaml|editorconfig|gitattributes|gitignore)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/\.git(/|$)

# ---- verificacao de dono do site (Google Search Console) ----
# O arquivo mora em verificacao/ e nao na raiz porque os scripts de build
# tratam todo .html da raiz como pagina do site. Aqui o servidor entrega
# ele no endereco que o Google pede, sem redirecionar. NAO APAGAR: sem esse
# arquivo o Search Console perde a verificacao.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(google[0-9a-f]+\.html)$ /verificacao/$1 [L]
</IfModule>

# ---- um endereco so: https, sem www ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://slowexe.com/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.slowexe\.com$ [NC]
  RewriteRule ^(.*)$ https://slowexe.com/$1 [R=301,L]
</IfModule>

# ---- protecao do navegador ----
# HSTS: o navegador so usa https neste dominio por 1 ano. Sem includeSubDomains de proposito.
# nosniff: o navegador nao "adivinha" o tipo de arquivo. SAMEORIGIN: nenhum outro site
# coloca slowexe.com dentro de um iframe (golpe de clique). Permissions: nada de camera/microfone.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- cache: imagem e video sao versionados pelo nome, HTML nunca ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType video/mp4             "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

ErrorDocument 404 /index.html
